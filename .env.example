# ==========================================================
#  666 BOT — ENVIRONMENT TEMPLATE
#  Copy this file to `.env` and fill in the values.
#  NEVER commit the real `.env` file.
# ==========================================================

# ---------- Discord (required) ----------
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
DISCORD_CLIENT_ID=
# Optional: deploy slash commands instantly to this guild (recommended while testing).
# Leave empty to deploy globally (can take up to 1 hour to propagate).
GUILD_ID=

# ---------- MongoDB (required) ----------
# Local:  mongodb://127.0.0.1:27017/666bot
# Atlas:  mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/666bot?retryWrites=true&w=majority
MONGODB_URI=

# ---------- Core behaviour ----------
# Default timezone used for daily reset (per-server override is stored in MongoDB)
DEFAULT_TIMEZONE=Asia/Jakarta

# Valid activity rules
ACTIVITY_COOLDOWN_SECONDS=60
MIN_MESSAGE_LENGTH=3

# Invitations
INVITE_TTL_HOURS=24
MAX_PENDING_INVITES=3

# Duo XP awarded per completed day
XP_PER_DAY=100

# Daily reminder hour (0-23) in the server timezone. Notifications are sent only once per day.
REMINDER_HOUR=21
REMINDER_MINUTE=0
NOTIFICATIONS_ENABLED=true

# Auto-register slash commands on startup (true/false)
AUTO_DEPLOY=true

# ---------- Optional Streak API (HTTP) ----------
# Useful for uptime monitoring / dashboards on Pterodactyl.
ENABLE_API=true
API_PORT=3000
API_HOST=0.0.0.0
# If set, /api/* requires the header `x-api-key: <value>`. /health stays public.
API_KEY=

# ---------- Logging ----------
# error | warn | info | debug
LOG_LEVEL=info
# Write logs to ./logs/666bot.log as well (true/false)
LOG_TO_FILE=false

# ---------- Misc ----------
# Node environment: production | development
NODE_ENV=production
